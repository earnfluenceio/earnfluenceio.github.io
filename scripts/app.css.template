/* Dashboard app shell - light indigo theme */
.app-shell { display: flex; min-height: 100vh; background: var(--surface-alt); font-family: 'Inter', -apple-system, sans-serif; color: var(--ink); }
.app-sidebar { width: 240px; flex-shrink: 0; background: var(--surface-alt); border-right: 1px solid var(--border); display: flex; flex-direction: column; min-height: 100vh; }
.app-sidebar-brand { padding: 1.25rem 1rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 0.5rem; text-decoration: none; color: var(--ink); font-weight: 700; font-size: 1rem; }
.app-sidebar-nav { flex: 1; padding: 1rem 0.75rem; overflow-y: auto; }
.app-nav-section { font-size: 0.68rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-light); padding: 0.5rem 0.6rem; margin-top: 0.5rem; }
.app-nav-section:first-child { margin-top: 0; }
.app-nav-item { display: flex; align-items: center; gap: 0.55rem; padding: 0.5rem 0.6rem; border-radius: 6px; font-size: 0.85rem; color: var(--ink-medium); text-decoration: none; margin-bottom: 0.1rem; transition: all 0.15s; }
.app-nav-item:hover { background: var(--indigo-pale); color: var(--indigo); }
.app-nav-item.active { background: var(--indigo-pale); color: var(--indigo); font-weight: 600; }
.app-nav-item svg { width: 18px; height: 18px; flex-shrink: 0; opacity: 0.7; }
.app-sidebar-footer { padding: 1rem; border-top: 1px solid var(--border); }
.app-sidebar-footer a { display: flex; align-items: center; gap: 0.5rem; text-decoration: none; color: var(--ink-medium); font-size: 0.85rem; }
.app-main { flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--bg); }
.app-content { flex: 1; padding: 1.5rem 2rem; overflow-y: auto; max-width: 1200px; width: 100%; margin: 0 auto; box-sizing: border-box; }
.app-page-header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 1.5rem; }
.app-page-header h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 0.25rem; }
.app-page-header p { font-size: 0.85rem; color: var(--ink-light); }
.app-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; margin-bottom: 1.5rem; }
.app-stat { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1rem 1.1rem; }
.app-stat-label { font-size: 0.72rem; color: var(--ink-light); font-weight: 500; margin-bottom: 0.25rem; }
.app-stat-val { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; }
.app-stat-delta { font-size: 0.72rem; color: var(--green); font-weight: 600; margin-top: 0.25rem; }
.app-stat-delta.neutral { color: var(--ink-light); }
.app-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; margin-bottom: 1.5rem; }
.app-card-head { padding: 1rem 1.25rem; border-bottom: 1px solid var(--border); font-weight: 600; font-size: 0.95rem; }
.app-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
.app-table th { text-align: left; padding: 0.65rem 1.25rem; font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-light); border-bottom: 1px solid var(--border); background: var(--surface-alt); }
.app-table td { padding: 0.75rem 1.25rem; border-bottom: 1px solid var(--border); color: var(--ink); }
.app-table tr:last-child td { border-bottom: none; }
.app-table tr:hover td { background: var(--surface-alt); }
.app-table .text-right { text-align: right; }
.app-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
.app-badge { display: inline-block; background: var(--green-pale); color: var(--green); font-size: 0.72rem; font-weight: 600; padding: 0.2rem 0.55rem; border-radius: 100px; }
.app-badge.indigo { background: var(--indigo-pale); color: var(--indigo); }
.app-badge.amber { background: var(--amber-pale); color: var(--amber); }
.app-avatar { width: 28px; height: 28px; border-radius: 50%; background: var(--indigo-pale); color: var(--indigo); display: inline-flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 700; margin-right: 0.5rem; vertical-align: middle; }
.app-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
.app-form-group { margin-bottom: 1rem; }
.app-form-group label { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.35rem; }
.app-form-group input, .app-form-group select, .app-form-group textarea { width: 100%; padding: 0.65rem 0.85rem; border: 1px solid var(--border-strong); border-radius: var(--radius); font-family: inherit; font-size: 0.95rem; box-sizing: border-box; }
.app-form-group input:focus, .app-form-group select:focus, .app-form-group textarea:focus { outline: none; border-color: var(--indigo); box-shadow: 0 0 0 3px var(--indigo-pale); }
.marketplace-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
.marketplace-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.5rem; transition: all 0.2s; text-decoration: none; color: inherit; display: block; }
.marketplace-card:hover { border-color: var(--indigo); box-shadow: var(--shadow); }
.marketplace-card h3 { font-size: 1.05rem; font-weight: 600; margin-bottom: 0.35rem; }
.marketplace-card p { font-size: 0.88rem; color: var(--ink-medium); margin-bottom: 0.75rem; }
@media (max-width: 900px) {
  .app-shell { flex-direction: column; }
  .app-sidebar { width: 100%; min-height: auto; border-right: none; border-bottom: 1px solid var(--border); }
  .app-sidebar-nav { display: flex; flex-wrap: wrap; gap: 0.25rem; padding: 0.75rem; }
  .app-nav-section { width: 100%; }
  .app-stats { grid-template-columns: repeat(2, 1fr); }
  .app-grid-2, .app-form-row, .marketplace-grid { grid-template-columns: 1fr; }
  .app-content { padding: 1rem; }
}
